{
  "name": "westeros-chronicles",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:no-emoji": "node scripts/check-no-emoji.mjs",
    "check:icons": "node scripts/check-game-icons.mjs",
    "check:ck3-attributes": "node scripts/check-ck3-attributes.mjs",
    "check:body-highlights": "node scripts/check-body-highlights.mjs",
    "check:character-creator": "node scripts/check-character-creator.mjs",
    "verify": "npm run check:no-emoji && npm run check:icons && npm run check:ck3-attributes && npm run check:body-highlights && npm run check:character-creator && npm run check:ck3-character-window && npm run check:story-character-links && npm run check:trait-effects && npm run check:trait-display && npm run check:current-equipment && npm run test:agot-character-import && npm run check:character-dataset && npm run test:character-runtime && npm run test:lord-relations && npm run test:character-dossier && npm run test:character-navigation && npm run test:trait-effects && npm run test:character-trait-display && npm run test:state-reducer && npm run test:equipment-queue && npm run test:equipment-queue-store && npm run test:dice-policy && npm run test:character-ai && npm run build",
    "test:trait-effects": "node --experimental-strip-types scripts/test-trait-effects.mjs",
    "test:character-trait-display": "node scripts/test-character-trait-display.mjs",
    "check:trait-effects": "node scripts/check-trait-effects.mjs",
    "check:trait-display": "node scripts/check-trait-display.mjs",
    "test:dice-policy": "node --experimental-strip-types scripts/test-dice-policy.mjs",
    "test:state-reducer": "node scripts/test-state-reducer.mjs",
    "test:equipment-queue": "npm run test:item-action-queue",
    "test:equipment-queue-store": "node scripts/test-equipment-queue-store.mjs",
    "check:current-equipment": "node scripts/check-current-equipment.mjs",
    "import:agot-characters": "python3 -m scripts.agot_character_import.cli --start-date 8298.1.1 --output public/data/agot-characters",
    "test:agot-character-import": "python3 -m unittest scripts.test_agot_character_import -v",
    "check:character-dataset": "node scripts/check-agot-character-dataset.mjs",
    "test:character-runtime": "node scripts/test-character-runtime.mjs",
    "test:character-scene": "node scripts/test-character-scene-selector.mjs",
    "test:character-prompt": "node scripts/test-character-prompt.mjs",
    "test:character-commands": "node --experimental-strip-types scripts/test-character-commands.mjs",
    "test:character-store": "node scripts/test-character-store.mjs",
    "test:character-ai": "npm run test:character-scene && npm run test:character-prompt && npm run test:character-commands && npm run test:character-store",
    "check:ck3-character-window": "node scripts/check-ck3-character-window.mjs",
    "test:lord-relations": "node scripts/test-lord-relationship-resolver.mjs",
    "test:character-dossier": "node scripts/test-character-dossier.mjs",
    "test:character-navigation": "node scripts/test-character-navigation.mjs",
    "check:story-character-links": "node scripts/check-story-character-links.mjs",
    "test:item-catalog": "node scripts/test-item-catalog.mjs",
    "test:item-custody": "node scripts/test-item-custody.mjs",
    "test:item-equipment": "node scripts/test-item-equipment.mjs",
    "test:item-effects": "node scripts/test-item-effects.mjs",
    "test:item-actions": "node scripts/test-item-actions.mjs",
    "test:item-action-queue": "node scripts/test-item-action-queue.mjs",
    "test:item-definitions": "node scripts/test-item-definitions.mjs",
    "test:item-save-version": "node scripts/test-item-save-version.mjs",
    "test:item-state-commands": "node scripts/test-item-state-commands.mjs",
    "test:item-dice-integration": "node scripts/test-item-dice-integration.mjs",
    "test:item-view-model": "node scripts/test-item-view-model.mjs",
    "check:item-equipment-ui": "node scripts/check-item-equipment-ui.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
