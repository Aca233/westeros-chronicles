{
  "name": "westeros-chronicles",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:code": "tsc && vite build --mode code-check",
    "preview": "vite preview",
    "check:no-emoji": "node scripts/check-no-emoji.mjs",
    "check:icons": "node scripts/check-game-icons.mjs",
    "check:ck3-attributes": "node scripts/check-ck3-attributes.mjs",
    "check:body-highlights": "node scripts/check-body-highlights.mjs",
    "check:character-creator": "node scripts/check-character-creator.mjs",
    "check:module-cycles": "node scripts/check-module-cycles.mjs",
    "check:trait-effects": "node scripts/check-trait-effects.mjs",
    "check:trait-display": "node scripts/check-trait-display.mjs",
    "check:imported-character-traits": "node scripts/check-imported-character-traits.mjs",
    "check:current-equipment": "node scripts/check-current-equipment.mjs",
    "import:agot-characters": "python3 -m scripts.agot_character_import.cli --start-date 8298.1.1 --output public/data/agot-characters",
    "check:character-dataset": "node scripts/check-agot-character-dataset.mjs",
    "check:ck3-character-window": "node scripts/check-ck3-character-window.mjs",
    "check:story-character-links": "node scripts/check-story-character-links.mjs",
    "check:item-equipment-ui": "node scripts/check-item-equipment-ui.mjs",
    "check:item-images": "node scripts/check-item-images.mjs",
    "import:agot-artifacts": "python3 -m scripts.agot_artifact_import.cli",
    "build:canonical-timeline": "python3 scripts/build_canonical_timeline.py",
    "check:world-timeline": "node scripts/check-world-timeline.mjs",
    "check:prompt-life-status": "node --experimental-strip-types scripts/check-prompt-life-status.mjs",
    "build:character-roster": "python3 -m scripts.prune_bundled_character_dataset --characters public/data/agot-characters",
    "check:character-portraits": "node scripts/check-character-portrait-dataset.mjs",
    "check:character-portraits-ui": "node scripts/check-character-portraits-ui.mjs",
    "import:character-portraits": "python3 -m scripts.character_portrait_import.cli",
    "import:agot-map": "python3 -m scripts.agot_map_import.cli --source /mnt/c/agot/2962333032 --data-output public/data/agot-map --asset-output public/assets/agot-map",
    "check:map-data": "node scripts/audit-agot-map.mjs",
    "check:map-drawer": "node --experimental-strip-types scripts/check-map-drawer.mjs",
    "check:map-travel-ui": "node --experimental-strip-types scripts/check-map-travel-ui.mjs",
    "check:map-runtime-boundaries": "node --experimental-strip-types scripts/check-map-runtime-boundaries.mjs",
    "check:world-runtime-boundaries": "node scripts/audit-world-runtime-boundaries.mjs",
    "import:agot-models": "python3 -m scripts.agot_model_import.cli convert --source /mnt/c/AGOT/2962333032 --converter-root \"$IO_PDX_MESH_ROOT\" --data-output public/data/agot-map/models --asset-output public/assets/agot-map/models",
    "audit:agot-models": "node scripts/audit-agot-models.mjs",
    "check:item-ownership-authority": "node scripts/check-ordinary-item-ownership-authority.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "build:world-content": "node scripts/world-content/compiler.mjs",
    "check:living-world-content-boundaries": "node scripts/check-living-world-content-boundaries.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "three": "0.185.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^24.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "meshoptimizer": "1.2.0",
    "postcss": "^8.5.3",
    "sharp": "0.34.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
